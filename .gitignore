# Local runtime logs and automatic recovery snapshots
mvp-server*.log
运行日志/
.mvp-backups/

# User-uploaded files are kept locally and must not be committed by default
data/mvp-uploads/
data/admin-backend/
data/migrations/

# Customer enquiries submitted through the website contact form (personal data)
data/mvp-leads.json
data/*.tmp

# 测试用的 Playwright 依赖，服务器上不需要
node_modules/

# WorkBuddy 的本地工作目录
.workbuddy/

# 交付发布包：里面是真实数据和账号哈希，绝不提交
部署/发布包/
部署/*.tar.gz
部署/SHA256SUMS

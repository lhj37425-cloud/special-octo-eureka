[Unit]
Description=EVOL DREAM 后台服务 (4181)
Documentation=file:///srv/evol/上线验收报告.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/evol
ExecStart=/usr/bin/node backend-server.js
Environment=NODE_ENV=production
Environment=ADMIN_PORT=4181
Environment=HOST=127.0.0.1
Environment=MVP_DATA_DIR=/srv/evol/data
Environment=ADMIN_DATA_DIR=/srv/evol/data/admin-backend
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
